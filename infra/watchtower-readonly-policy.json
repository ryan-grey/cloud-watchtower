{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlarmStateReadOnly",
      "Effect": "Allow",
      "Action": ["cloudwatch:DescribeAlarms"],
      "Resource": "*"
    },
    {
      "Sid": "MetricsReadOnly",
      "Effect": "Allow",
      "Action": ["cloudwatch:GetMetricData"],
      "Resource": "*"
    },
    {
      "Sid": "BudgetReadOnly",
      "Effect": "Allow",
      "Action": ["budgets:ViewBudget", "budgets:DescribeBudget"],
      "Resource": "arn:aws:budgets::<ACCOUNT_ID>:budget/<BUDGET_NAME>"
    },
    {
      "Sid": "CostExplorerReadOnlyManualOnly",
      "Effect": "Allow",
      "Action": ["ce:GetCostAndUsage"],
      "Resource": "*"
    }
  ]
}
